{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peekling/awesome-peeklings/schemas/catalog.schema.json",
  "title": "Awesome Peeklings catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "repository", "peeklings"],
  "properties": {
    "$schema": {
      "const": "./schemas/catalog.schema.json"
    },
    "format": {
      "const": 1
    },
    "repository": {
      "const": "https://github.com/peekling/awesome-peeklings"
    },
    "peeklings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/peekling"
      }
    }
  },
  "$defs": {
    "peekling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "creator",
        "github",
        "version",
        "license",
        "path",
        "thumbnail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "version": {
          "type": "string"
        },
        "license": {
          "enum": ["Apache-2.0", "CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"]
        },
        "path": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        }
      }
    }
  }
}
